DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
DISCORD_REDIRECT_URI=https://your-service.onrender.com/auth/callback
CLIENT_ID=your_application_id
# Optional: this server also receives an instant mirror; global commands are registered too.
DEV_GUILD_ID=your_test_server_id

# Optional defaults
BOT_PREFIX=!

# Optional: comma-separated words blocked by automod
BLOCKED_WORDS=badword1,badword2

# Dashboard defaults to localhost for safety.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
# Use a reachable HTTPS/HTTP URL in /about when the dashboard is hosted remotely.
DASHBOARD_PUBLIC_URL=https://your-service.onrender.com
