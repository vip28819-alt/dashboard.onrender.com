{
  "name": "probot-style-discord-bot",
  "version": "1.0.0",
  "description": "A configurable ProBot-style Discord bot with moderation, automod, levels, welcome messages, logging, and tickets.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "stop": "node src/stop-bot.js",
